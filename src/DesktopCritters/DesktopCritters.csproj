<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DesktopCritters</AssemblyName>
    <RootNamespace>DesktopCritters</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Keep the footprint small: no globalization tables, workstation GC, no
         background GC thread. The whole app is one thread doing one job. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shipped creature definitions are embedded so a fresh install can seed
         %APPDATA%\DesktopCritters without needing the repo alongside it. -->
    <EmbeddedResource Include="..\..\assets\creatures\*.json">
      <LogicalName>creatures/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
